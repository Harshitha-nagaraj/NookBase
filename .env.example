# RAG Debugger Environment Variables Example
# Copy this file to .env for local overrides or set these variables in your hosting provider console.
# DO NOT add real secrets or API keys to this file.

# ==============================================================================
# BACKEND CONFIGURATION (FastAPI)
# ==============================================================================

# Application Port & Host (Provided dynamically by platform such as Render/Railway/Fly)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origin for Production Frontend (Comma-separated if multiple)
# Default allows local dev origins (http://localhost:5173, http://127.0.0.1:5173, etc.)
FRONTEND_URL=

# Vector Store Persistence Path
CHROMA_PERSIST_DIRECTORY=./data/chromadb

# Embedding Model Name
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Diagnostic Thresholds
DISTANCE_THRESHOLD_HIGH=1.0
DISTANCE_THRESHOLD_MEDIUM=1.5
GROUNDING_DISTANCE_THRESHOLD=1.2

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React)
# ==============================================================================

# Base URL of the backend API (Default fallback in code: http://127.0.0.1:8000)
VITE_API_BASE_URL=
